AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Agents (fast, temperature 0) and reports (stronger model): inference profile IDs.
# Tested 2026-10-10. Claude 5.5 models fail on our account (marketplace access).
BEDROCK_AGENT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Victim model for the calendar-injection demo; also used by Mirage detonation.
MEETING_ASSISTANT_MODEL_ID=openai.gpt-oss-20b-1:0
BEDROCK_REPORT_MODEL_ID=us.anthropic.claude-opus-4-8
# Decision model + judge (plain model IDs, no inference profile)
BEDROCK_GATE_MODEL_ID=openai.gpt-oss-safeguard-20b
BEDROCK_JUDGE_MODEL_ID=openai.gpt-oss-safeguard-120b

# Google (Gmail + Calendar), OAuth desktop client. Files stay out of Git.
GOOGLE_CLIENT_SECRETS_FILE=secrets/google_client.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
DEMO_USER_EMAIL=
ATTACKER_EMAIL=

# CRM
HUBSPOT_TOKEN=

# GitHub (fine-grained token, this repo only: contents + pull requests)
GITHUB_TOKEN=
GITHUB_REPO=GabDestal/Mirage

MIRAGE_MODE=replay

# Ask Mirage: Node loopback chat service; model must support ConverseStream + tools.
# Defaults to BEDROCK_AGENT_MODEL_ID, then BEDROCK_MODEL_ID when blank.
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-opus-4-8
MIRAGE_CHAT_PORT=8001
# Browser origins forwarded through the same-origin Vite /chat proxy (no CORS).
MIRAGE_CHAT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001
# Engine URL used by the existing MCP server; chat never imports engine/.
MIRAGE_API=http://localhost:8000
